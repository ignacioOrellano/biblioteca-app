doctype html
html
  head
    title Biblioteca Comunitaria
  body
    nav
      div.items
        a(href='/') Inicio
        if currentUser
          a(href='/libros') Libros
          a(href='/usuarios') Usuarios
          if currentUser.rol == 'admin'
            a(href='/prestamos') Préstamos
          a(href='/prestamos/usuario') Mis Préstamos
      div.login
        if currentUser
          span Bienvenido, #{currentUser.nombre} (#{currentUser.rol})
          a(href='/logout') Cerrar Sesión
        else
          a(href='/login') Login
    block content
  
  style.
    nav {
      display: flex;
      justify-content: space-between;
    }
    div.items{
      display: flex;
      gap: 10px;
    }
    div.login{
      display:flex;
      gap: 10px;
    }
