extends layout

block content
  h1 Iniciar Sesión
  
  if error
    .error-message= error
  
  form(action='/login' method='POST')
    label(for='dni') DNI:
      input(type='text' id='dni' name='dni' required)  
   
    label(for='password') Contraseña:
      input(type='password' id='password' name='password' required) 
    
    button(type='submit') Ingresar

  style.
    form[action='/login'] {
      display: flex;
      flex-direction: column;
      gap : 10px;
      space-between: 10px;
      align-items: center;
      max-width: 300px;

      & label {
        display: flex;
        flex-direction: column;
        width: 100%;
      }
    }